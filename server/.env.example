# TagTeam2 server env — copy to server/.env and fill in. Real values never committed.
# Migrated from the old TagTeam repo + probed homelab routes (PLAN.md §2.1).

# Perxona Connect (one shared identity; server mints connect_tokens)
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=

# Homelab LLM (server-side)
LLM_BASE_URL=https://a0.mango-rockhopper.ts.net/v1
LLM_API_KEY=
LLM_MODEL=gemma4-26b-a4b-nothink

# Homelab STT (hosted, OpenAI-compatible) — route probed in S0. Only used
# for non-Japanese transcription now (intake's English) — see STT_LOCAL below.
STT_BASE_URL=https://stt.mango-rockhopper.ts.net/v1
STT_API_KEY=
STT_MODEL=nvidia/nemotron-asr
STT_LANGUAGE=ja

# Local STT (whisper.cpp + Kotoba-Whisper, baked into the image — see
# docs/adr/0012-local-kotoba-whisper-stt.md). Handles all Japanese
# transcription (practice calls, drills). Defaults below match the
# container's built-in whisper-server; only override for local dev outside
# Docker, or to disable and fall back to the hosted STT for ja too.
# STT_LOCAL_ENABLED=true
# STT_LOCAL_BASE_URL=http://127.0.0.1:8090

# Homelab BYO-TTS (OpenAI-compatible) — route probed in S0
TTS_BASE_URL=https://tts.mango-rockhopper.ts.net/v1
TTS_API_KEY=
TTS_MODEL=kokoro-82m
TTS_VOICE=susan
TTS_LANGUAGE=ja

# Fixed-target asset IDs (migrated from old presets.ts)
COACH_AVATAR_ID=01KD2H4NWSZP4Y3CK8P3PSHTYP
PRACTICE_AVATAR_ID=01KH0D8ZAZHZ762FV5SK3503ZR
COACH_SCENE_ID=01K4NYB6627539QRJR2HXESJJK
PRACTICE_SCENE_ID=01K4NYBH42K727CZYGH6DC7Z2C
COACH_VOICE_ID=01KTBJGRFKWS029KQKQBC3318V
# P4 (ADR-0008): live Perxona ja voice for LLM-authored practice lines
# "Male – calm and approachable" — matches the male role avatar (2026-09-05)
PRACTICE_VOICE_ID=01KZFHK5FX4D4CFVKN9TXAJSBW
